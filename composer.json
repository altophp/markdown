{
    "name": "alto/markdown",
    "description": "Parse, query, lint, build, render, and edit Markdown with minimal diffs.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "markdown",
        "commonmark",
        "gfm",
        "parser",
        "linter",
        "renderer"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "homepage": "https://altophp.com/markdown",
    "support": {
        "issues": "https://github.com/altophp/markdown/issues",
        "source": "https://github.com/altophp/markdown",
        "docs": "https://altophp.com/markdown"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-dom": "Required for HtmlPolicy::curated() HTML sanitization"
    },
    "autoload": {
        "psr-4": {
            "Alto\\Markdown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Markdown\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "coverage": [
            "vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml --coverage-text",
            "@coverage:check"
        ],
        "coverage:check": "php tests/coverage-check.php .phpunit.cache/clover.xml 99",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "phpunit"
    }
}
